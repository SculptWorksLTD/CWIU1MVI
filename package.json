{
  "name": "cwiu1mvi",
  "productName": "CWIU1MVI",
  "version": "1.2.5",
  "description": "Decoder CW per radio con USB: tutte le stazioni in banda, CAT, cluster, QSO con log ADIF. Sviluppato da IU1MVI, uso libero per tutti gli OM.",
  "author": "IU1MVI",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis zip --x64 --publish never",
    "dist:mac": "electron-builder --mac dir --arm64 --publish never",
    "dist:linux": "electron-builder --linux AppImage deb --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.iu1mvi.cwiu1mvi",
    "productName": "CWIU1MVI",
    "copyright": "Sviluppato da IU1MVI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "app/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build/icon.png",
      "identity": null,
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "CWIU1MVI ascolta l'audio USB della radio per decodificare il CW.",
        "NSDocumentsFolderUsageDescription": "CWIU1MVI salva il log delle stazioni e dei messaggi ricevuti in Documenti › CWIU1MVI › Log."
      }
    },
    "win": {
      "icon": "build/icon.png",
      "artifactName": "CWIU1MVI-${version}-Windows.${ext}",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "zip"
      ]
    },
    "electronDist": "node_modules/electron/dist",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CWIU1MVI",
      "uninstallDisplayName": "CWIU1MVI",
      "installerLanguages": [
        "it_IT"
      ],
      "language": "1040",
      "license": "build/license.txt",
      "deleteAppDataOnUninstall": false,
      "artifactName": "CWIU1MVI-${version}-Setup.${ext}",
      "runAfterFinish": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "HamRadio",
      "icon": "build/icon.png",
      "artifactName": "CWIU1MVI-${version}-Linux.${ext}",
      "maintainer": "IU1MVI <iu1mvi@users.noreply.github.com>",
      "synopsis": "CW decoder for USB radios",
      "executableName": "cwiu1mvi"
    }
  },
  "homepage": "https://github.com/SculptWorksLTD/CWIU1MVIRelease"
}
