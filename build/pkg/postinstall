#!/bin/sh
# L'app installata appartiene all'utente: così si aggiorna da sola senza chiedere la password.
APP="/Applications/CWIU1MVI.app"
U=$(stat -f%Su /dev/console 2>/dev/null)
if [ -n "$U" ] && [ "$U" != "root" ] && [ -d "$APP" ]; then chown -R "$U":staff "$APP"; fi
xattr -dr com.apple.quarantine "$APP" 2>/dev/null
exit 0
